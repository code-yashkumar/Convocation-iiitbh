# ==============================================================================
# IIIT BHAGALPUR CONVOCATION 2026 - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the root project folder (ConvocationIIITBH/.env)
#
# IMPORTANT:
# - Ensure all variable names start with 'VITE_'
# - Wrap values in double quotes
# - Restart dev server (npm run dev) after creating/editing .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE APPS SCRIPT WEBHOOK URL (FOR STUDENT REGISTRATION FORM)
# ------------------------------------------------------------------------------
# Format: Must be the Web App URL ending in '/exec'
# Example: https://script.google.com/macros/s/AKfycbz_XXXXXXXXXXXX/exec
VITE_GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"


# ------------------------------------------------------------------------------
# 2. GOOGLE DRIVE ALBUM LINKS (FOR THE 4 GALLERY CARDS)
# ------------------------------------------------------------------------------
# Supported Drive Formats:
#   1. Shared Folder link:  https://drive.google.com/drive/folders/1R-c4xV0crbNjCzuOWkCi5y2vytPULigu?usp=sharing
#   2. Standard Folder:     https://drive.google.com/drive/folders/1R-c4xV0crbNjCzuOWkCi5y2vytPULigu
#   3. User Folder link:    https://drive.google.com/drive/u/0/folders/1R-c4xV0crbNjCzuOWkCi5y2vytPULigu
# ------------------------------------------------------------------------------

# Card 1: Degree Distribution Ceremony Album
VITE_DRIVE_DEGREE_DISTRIBUTION_URL="https://drive.google.com/drive/folders/YOUR_DEGREE_DISTRIBUTION_FOLDER_ID"

# Card 2: Convocation Evening Album
VITE_DRIVE_CONVOCATION_EVENING_URL="https://drive.google.com/drive/folders/YOUR_CONVOCATION_EVENING_FOLDER_ID"

# Card 3: Alumni Meet Album
VITE_DRIVE_ALUMNI_MEET_URL="https://drive.google.com/drive/folders/YOUR_ALUMNI_MEET_FOLDER_ID"

# Card 4: Speaker Session Album
VITE_DRIVE_SPEAKER_SESSION_URL="https://drive.google.com/drive/folders/YOUR_SPEAKER_SESSION_FOLDER_ID"


# ------------------------------------------------------------------------------
# 4. LIVE GOOGLE SHEET INTEGRATION FOR NOTICES & CIRCULARS
# ------------------------------------------------------------------------------
# Any standard Google Sheet with sharing set to 'Anyone with link can view'.
#
# Required Column Headers in Row 1 of the Sheet:
#   Title | Category | Date | Ref No | Description | Issued By | PDF Link | Pinned
#
# Supported link formats:
#   1. Standard Sheet Link: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit?usp=sharing
#   2. Specific Tab Link:   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit#gid=0
#   3. Webhook / JSON URL:  https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
#
# Example:
# VITE_NOTICES_SHEET_URL="https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit?usp=sharing"
# ------------------------------------------------------------------------------
VITE_NOTICES_SHEET_URL=""
